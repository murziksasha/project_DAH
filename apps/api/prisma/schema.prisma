generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  chairman
  accountant
  board
  /// УК / ОСББ: диспетчер заявок (черга + SLA, без фінансів)
  dispatcher
  /// Виконавець / бригада (лише призначені заявки)
  crew
  resident
  auditor
}

enum RequestPriority {
  low
  normal
  high
  urgent
}

enum FundType {
  maintenance
  capital_repair
  special
}

enum AccrualDistribution {
  by_area
  fixed_per_apartment
  manual
  by_meter
}

enum MeterType {
  cold_water
  hot_water
  heating
  electricity
  other
}

enum AccrualLineStatus {
  open
  partially_paid
  paid
  overdue
}

enum PaymentSource {
  bank
  cash
  transfer
}

enum RequestStatus {
  new
  in_progress
  done
}

enum UserStatus {
  pending
  active
  blocked
}

enum JournalEntryType {
  accrual
  payment
  expense
  void_payment
  void_expense
  opening
}

enum VoteWeightMode {
  one_per_user
  one_per_apartment
  by_area
}

/** ОСББ or managing company (УК) — same product «Мій дім». */
enum OrganizationType {
  osbb
  management_company
}

/** One legal organization (ОСББ or УК) on a shared install. Multi-tenant foundation. */
model Tenant {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  orgType   OrganizationType @default(osbb)
  isActive  Boolean          @default(true)
  settings  Json             @default("{}")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  buildings Building[]
  users     User[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole   @default(resident)
  status       UserStatus @default(pending)
  /// null = platform super_admin (cross-tenant); otherwise organization tenant
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  apartmentId  String?
  primaryApartment Apartment? @relation("UserPrimaryApartment", fields: [apartmentId], references: [id])
  /// Who activated the account (registration approve or admin status→active)
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?      @relation("UserApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[]    @relation("UserApprovedBy")
  refreshToken String?
  totpSecret         String?
  totpEnabled        Boolean  @default(false)
  totpTempSecret     String?
  emailNotifyEnabled Boolean  @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  apartmentLinks     UserApartment[]
  authSessions       AuthSession[]
  auditLogs          AuditLog[]
  createdExpenses    Expense[]           @relation("ExpenseCreatedBy")
  announcements      Announcement[]
  requests           Request[]           @relation("RequestAuthor")
  assignedRequests   Request[]           @relation("RequestAssignee")
  pushSubscriptions  PushSubscription[]
  reminders          Reminder[]          @relation("ReminderTarget")
  createdReminders   Reminder[]          @relation("ReminderCreator")
  meetingsCreated    Meeting[]           @relation("MeetingCreatedBy")
  meetingParticipants MeetingParticipant[]
  meetingVotes       MeetingVote[]
  meetingSignatures  MeetingSignature[]
  chatMemberships    ChatThreadMember[]
  chatMessages       ChatMessage[]

  @@index([tenantId])
  @@index([approvedById])
}

/** Refresh-token session with rotation + reuse detection (v1.0). */
model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId         String
  refreshTokenHash String
  revokedAt        DateTime?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model UserApartment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([userId, apartmentId])
  @@index([apartmentId])
}

model Building {
  id                      String   @id @default(cuid())
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name                    String
  address                 String
  edrpou                  String?
  showDebtorsToResidents  Boolean  @default(true)
  isInitialized           Boolean  @default(false)
  settings                Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  apartments  Apartment[]
  bankAccounts BankAccount[]
  funds       Fund[]
  suppliers   Supplier[]

  @@index([tenantId])
}

model Apartment {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  number     String
  entrance   Int      @default(1)
  floor      Int?
  area       Float
  /// Prepaid balance (advance) in major units — first-class, updated with payments/voids.
  advanceBalance Decimal @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  residents      Resident[]
  primaryUsers   User[]            @relation("UserPrimaryApartment")
  apartmentLinks UserApartment[]
  accrualLines   AccrualLine[]
  payments       Payment[]
  reminders      Reminder[]
  pollVotes      PollVote[]
  meters         Meter[]

  @@unique([buildingId, number])
}

model Meter {
  id           String    @id @default(cuid())
  apartmentId  String
  apartment    Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  type         MeterType @default(cold_water)
  name         String
  unit         String    @default("m3")
  serialNumber String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  readings MeterReading[]

  @@index([apartmentId])
  @@index([type])
}

model MeterReading {
  id            String   @id @default(cuid())
  meterId       String
  meter         Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  period        String
  value         Decimal  @db.Decimal(14, 3)
  previousValue Decimal? @db.Decimal(14, 3)
  consumption   Decimal  @db.Decimal(14, 3)
  createdAt     DateTime @default(now())

  @@unique([meterId, period])
  @@index([period])
}

model Resident {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])
  firstName   String
  lastName    String
  phone       String?
  email       String?
  /// Personal / payer IBAN for bank statement matching
  iban        String?
  isOwner     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([iban])
}

model BankAccount {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id])
  bankName    String
  iban        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  funds Fund[]
}

model Fund {
  id            String    @id @default(cuid())
  buildingId    String
  building      Building  @relation(fields: [buildingId], references: [id])
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  type          FundType
  name          String
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses         Expense[]
  accrualTemplates AccrualTemplate[]
  accruals         Accrual[]
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  expenses Expense[]
}

model Supplier {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id])
  name        String
  edrpou      String?
  iban        String?
  phone       String?
  serviceType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  fundId      String
  fund        Fund            @relation(fields: [fundId], references: [id])
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  supplierId  String?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  description String?
  documentKey String?
  isVoided    Boolean         @default(false)
  voidReason  String?
  createdById String
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AccrualTemplate {
  id           String              @id @default(cuid())
  fundId       String
  fund         Fund                @relation(fields: [fundId], references: [id])
  name         String
  distribution AccrualDistribution
  rate         Decimal?            @db.Decimal(12, 4)
  fixedAmount  Decimal?            @db.Decimal(12, 2)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  accruals Accrual[]
}

model Accrual {
  id         String   @id @default(cuid())
  fundId     String
  fund       Fund     @relation(fields: [fundId], references: [id])
  templateId String?
  template   AccrualTemplate? @relation(fields: [templateId], references: [id])
  period     String
  title      String
  createdAt  DateTime @default(now())

  lines AccrualLine[]
}

model AccrualLine {
  id          String            @id @default(cuid())
  accrualId   String
  accrual     Accrual           @relation(fields: [accrualId], references: [id])
  apartmentId String
  apartment   Apartment         @relation(fields: [apartmentId], references: [id])
  amount      Decimal           @db.Decimal(12, 2)
  paidAmount  Decimal           @default(0) @db.Decimal(12, 2)
  status      AccrualLineStatus @default(open)
  dueDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  allocations PaymentAllocation[]
}

model Payment {
  id          String        @id @default(cuid())
  apartmentId String
  apartment   Apartment     @relation(fields: [apartmentId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  date        DateTime
  source      PaymentSource
  reference   String?
  isVoided    Boolean       @default(false)
  voidReason  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  allocations PaymentAllocation[]
  onlineOrder OnlinePaymentOrder?
}

/// Persisted online checkout (LiqPay / WayForPay / generic) for idempotent webhooks.
model OnlinePaymentOrder {
  id           String    @id @default(cuid())
  orderId      String    @unique
  apartmentId  String
  amount       Decimal   @db.Decimal(12, 2)
  userId       String?
  provider     String    @default("generic")
  status       String    @default("pending") // pending | paid | failed | cancelled
  description  String?
  paymentId    String?   @unique
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  providerMeta Json      @default("{}")
  createdAt    DateTime  @default(now())
  paidAt       DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([apartmentId])
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  paymentId     String
  payment       Payment     @relation(fields: [paymentId], references: [id])
  accrualLineId String
  accrualLine   AccrualLine @relation(fields: [accrualLineId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  isPinned  Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Request {
  id          String          @id @default(cuid())
  title       String
  description String
  category    String
  status      RequestStatus   @default(new)
  priority    RequestPriority @default(normal)
  authorId    String
  author      User            @relation("RequestAuthor", fields: [authorId], references: [id])
  assigneeId  String?
  assignee    User?           @relation("RequestAssignee", fields: [assigneeId], references: [id])
  /// SLA target datetime (auto-filled from category/priority if omitted)
  dueAt       DateTime?
  /// MinIO object keys for attached photos
  photoKeys   Json            @default("[]")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, dueAt])
  @@index([assigneeId, status])
}

model Poll {
  id            String         @id @default(cuid())
  question      String
  isActive      Boolean        @default(true)
  endsAt        DateTime?
  voteWeight    VoteWeightMode @default(one_per_user)
  /// Required participation percent of eligible weight (null = no quorum)
  quorumPercent Decimal?       @db.Decimal(5, 2)
  createdAt     DateTime       @default(now())

  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String

  votes PollVote[]
}

model PollVote {
  id          String     @id @default(cuid())
  pollId      String
  poll        Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId    String
  option      PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId      String
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  weight      Decimal    @default(1) @db.Decimal(12, 4)
  createdAt   DateTime   @default(now())

  @@unique([pollId, userId])
  @@index([pollId, apartmentId])
}

/// Immutable financial journal (v1.0 accounting foundation).
model JournalEntry {
  id          String           @id @default(cuid())
  type        JournalEntryType
  buildingId  String?
  apartmentId String?
  fundId      String?
  refType     String
  refId       String
  description String?
  createdById String?
  createdAt   DateTime         @default(now())

  lines JournalLine[]

  @@index([refType, refId])
  @@index([type, createdAt])
  @@index([buildingId, createdAt])
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Logical account code: receivable | cash | advance | expense | fund_balance
  account     String
  apartmentId String?
  fundId      String?
  debit       Decimal      @default(0) @db.Decimal(14, 2)
  credit      Decimal      @default(0) @db.Decimal(14, 2)

  @@index([entryId])
  @@index([account, apartmentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  payload    Json?
  createdAt  DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileKey     String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([to])
}

model Reminder {
  id          String    @id @default(cuid())
  type        String
  title       String
  body        String?
  dueAt       DateTime
  sentAt      DateTime?
  userId      String?
  user        User?     @relation("ReminderTarget", fields: [userId], references: [id], onDelete: SetNull)
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  meta        Json?
  createdAt   DateTime  @default(now())

  @@index([dueAt, sentAt])
  @@index([userId])
}

// ─── Meetings (загальні збори) + КЕП ─────────────────────────────────────────

enum MeetingStatus {
  draft
  scheduled
  open
  closed
  cancelled
}

enum MeetingType {
  general
  board
  founding
  other
}

model Meeting {
  id             String         @id @default(cuid())
  buildingId     String?
  title          String
  description    String?
  type           MeetingType    @default(general)
  status         MeetingStatus  @default(draft)
  scheduledAt    DateTime?
  endsAt         DateTime?
  quorumPercent  Decimal?       @db.Decimal(5, 2)
  voteWeight     VoteWeightMode @default(one_per_apartment)
  protocolText   String?
  createdById    String?
  createdBy      User?          @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  agendaItems  MeetingAgendaItem[]
  participants MeetingParticipant[]
  signatures   MeetingSignature[]

  @@index([status, scheduledAt])
  @@index([buildingId])
}

model MeetingAgendaItem {
  id          String  @id @default(cuid())
  meetingId   String
  meeting     Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  title       String
  description String?
  /// Vote options as JSON string array, e.g. ["За","Проти","Утримався"]
  options     Json    @default("[\"За\",\"Проти\",\"Утримався\"]")

  votes MeetingVote[]

  @@index([meetingId])
}

model MeetingParticipant {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartmentId String?
  weight      Decimal  @default(1) @db.Decimal(12, 4)
  registeredAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([meetingId])
}

model MeetingVote {
  id           String            @id @default(cuid())
  agendaItemId String
  agendaItem   MeetingAgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartmentId  String?
  optionKey    String
  weight       Decimal           @default(1) @db.Decimal(12, 4)
  createdAt    DateTime          @default(now())

  @@unique([agendaItemId, userId])
  @@index([agendaItemId])
}

/// Qualified electronic signature (КЕП) / Diia.Sign — result linked to meeting.
model MeetingSignature {
  id                String   @id @default(cuid())
  meetingId         String
  meeting           Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   @default("mock") // mock | diia | cloud_kep | cades
  status            String   @default("pending") // pending | signed | failed
  /// Link to SignSession when started via /api/kep
  sessionId         String?
  signaturePayload  Json     @default("{}")
  signedAt          DateTime?
  createdAt         DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([sessionId])
}

/**
 * Cross-document QES / Diia.Підпис session.
 * purpose e.g. meeting_protocol | custom_document
 */
model SignSession {
  id                 String    @id @default(cuid())
  purpose            String
  refType            String
  refId              String
  userId             String
  provider           String
  status             String    @default("pending") // pending | waiting_user | signed | failed | expired | cancelled
  /// SHA-256 hex of canonical document bytes/text
  digest             String
  documentTitle      String
  documentText       String?
  challenge          String
  /// External IdP session / request id (Diia offer id, cloud order id)
  externalSessionId  String?
  authorizeUrl       String?
  deeplink           String?
  /// Base64 CAdES / CMS signature when available
  signatureCms       String?   @db.Text
  certificateSubject String?
  certificateSerial  String?
  resultPayload      Json      @default("{}")
  errorMessage       String?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  @@index([userId, status])
  @@index([refType, refId])
  @@index([externalSessionId])
  @@index([expiresAt])
}

// ─── Messenger ───────────────────────────────────────────────────────────────

enum ChatThreadKind {
  building
  entrance
  board_residents
  direct
}

model ChatThread {
  id         String         @id @default(cuid())
  buildingId String?
  kind       ChatThreadKind @default(building)
  title      String?
  entrance   Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  members  ChatThreadMember[]
  messages ChatMessage[]

  @@index([buildingId, kind])
}

model ChatThreadMember {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  joinedAt   DateTime   @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}