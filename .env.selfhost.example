# ==============================================================================
# «Мій дім» — Self-Hosted Environment (.env.selfhost)
# ==============================================================================
# Інструкція:
# 1. Скопіюйте цей файл: cp .env.selfhost.example .env.selfhost
# 2. Вкажіть ваше доменне ім'я KeenDNS (наприклад: dim.keenetic.link або dim.keenetic.pro)
# 3. Запустіть стек:
#    docker compose --env-file .env.selfhost -f docker-compose.selfhost.yml up -d --build
# ==============================================================================

# Порт на локальному комп'ютері, на який роутер Keenetic перенаправляє запити (типово 80 або 8080)
HOST_HTTP_PORT=80

# ==============================================================================
# Домен KeenDNS та URL
# ==============================================================================
# Якщо використовується Хмарний режим KeenDNS (сіра IP за NAT):
# DOMAIN=my-house.keenetic.link
# APP_URL=https://my-house.keenetic.link
# COOKIE_SECURE=true
#
# Якщо локальний доступ (LAN IP для тесту):
DOMAIN=my-house.keenetic.link
APP_URL=https://my-house.keenetic.link
NEXT_PUBLIC_API_URL=/api

# У хмарному режимі Keenetic Cloud шифрує трафік по HTTPS, тому ставимо true
COOKIE_SECURE=true

# ==============================================================================
# База даних (PostgreSQL 16)
# ==============================================================================
POSTGRES_USER=dah
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=dah

# ==============================================================================
# Ключі безпеки (Мінімум 32 символи)
# ==============================================================================
# Згенеруйте надійні випадкові рядки, наприклад у PowerShell:
# -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 48 | ForEach-Object {[char]$_})
# або: openssl rand -hex 32
# API/worker НЕ стартують у production, якщо значення схожі на приклади (REPLACE_WITH, change_me…).
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_FOR_JWT
# Має відрізнятися від JWT_SECRET (API не стартує з однаковими / прикладними значеннями)
FILE_DOWNLOAD_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_HEX_FOR_FILES

# ==============================================================================
# Локальне сховище файлів (MinIO S3)
# ==============================================================================
S3_ACCESS_KEY=dah_storage_user
S3_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_SECRET
S3_BUCKET=dah-files

# ==============================================================================
# Системні налаштування
# ==============================================================================
NODE_ENV=production
SWAGGER_ENABLED=false
# Демо-підпис КЕП (mock) у production вимкнено. Не вмикайте на реальних зборах.
KEP_ALLOW_MOCK=false
TRUST_PROXY=1

# Бекапи (зберігаються локально в ./backups)
BACKUP_DIR=/backups
BACKUP_STATUS_PATH=/backups/last-backup.json
BACKUP_MAX_AGE_HOURS=192

# --- Phase 2 (docs/UPGRADE-phase2.md) — усе опційне ---
# METRICS_TOKEN=REPLACE_WITH_RANDOM_TOKEN   # Bearer для GET /api/metrics (Prometheus); без нього в production → 404
# LOG_FORMAT=json                           # JSON-логи API/worker (Loki/ELK); за замовчуванням text
# LOG_LEVEL=log                             # error|warn|log|debug|verbose
# AUTH_CACHE_TTL_MS=0                       # кеш автентифікації (мс); 0 = вимкнено
# TENANT_AUTO_SCOPE=true                    # false = аварійно вимкнути автоматичну tenant-ізоляцію Prisma
# JOURNAL_SOT_STREAK_DAYS=30                # днів поспіль readyForSot перед перемиканням журналу як SoT
# BACKUP_ENCRYPTION_PASSPHRASE_FILE=/root/.dah-backup-pass   # шифрування infra/scripts/backup.sh (openssl)
# MINIO_IMAGE=minio/minio:RELEASE.<дата>    # закріпити версію MinIO
# MINIO_MC_IMAGE=minio/mc:RELEASE.<дата>
# DAH_VERSION=                              # перевизначити версію в /health, Swagger, метриках
