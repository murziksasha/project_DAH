[Unit]
Description=DAH MinIO (S3-compatible storage)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@DAH_ROOT@@
ExecStart=@@DAH_ROOT@@/infra/scripts/run-minio.sh
Restart=on-failure
RestartSec=5
# Soft resource limits for weak hosts
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
