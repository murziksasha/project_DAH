# ==============================================================================
# «Мій дім» — Production Environment (.env.product)
# ==============================================================================
# Copy this file to .env.product:
#   cp .env.product.example .env.product
#
# IMPORTANT SECURITY RULES:
# 1. DO NOT commit .env.product to git (it is included in .gitignore).
# 2. DO NOT use placeholder values (change_me, REPLACE_, password123).
# 3. SUPER_ADMIN_PASSWORD is FORBIDDEN in this file. The initial super-admin
#    is created once via CLI (npm run db:super-admin), password kept in a password manager.
# 4. JWT_SECRET and FILE_DOWNLOAD_SECRET MUST be separate, distinct 32+ character secrets.
# ==============================================================================

# Compose project and existing external volumes (must NOT be deleted or recreated)
COMPOSE_PROJECT_NAME=project_dah
POSTGRES_DATA_VOLUME=project_dah_postgres_data
MINIO_DATA_VOLUME=project_dah_minio_data

# PostgreSQL Superuser (only used for Postgres engine init & one-off prisma migrate)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_SUPERUSER_PASSWORD
POSTGRES_DB=dah

# Application Database Role (strictly non-superuser role used by API and worker runtime)
POSTGRES_APP_USER=dah_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD
DATABASE_URL=postgresql://dah_app:REPLACE_WITH_STRONG_APP_PASSWORD@postgres:5432/dah

# Secrets (minimum 32 characters, MUST be distinct from each other)
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING_FOR_JWT
FILE_DOWNLOAD_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_STRING_FOR_FILES

# MinIO Root credentials (used ONLY inside minio engine, not exposed to API)
S3_ROOT_USER=minio_admin
S3_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_ROOT_PASSWORD

# MinIO Application credentials (scoped to dah-files bucket, used by API and worker)
S3_ACCESS_KEY=dah_app_storage
S3_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_APP_SECRET
S3_BUCKET=dah-files

# Domain and HTTPS URLs
DOMAIN=osbb.example.com
CORS_ORIGIN=https://osbb.example.com
APP_URL=https://osbb.example.com
NEXT_PUBLIC_API_URL=https://osbb.example.com/api

# Security Settings
NODE_ENV=production
COOKIE_SECURE=true
SWAGGER_ENABLED=false
KEP_ALLOW_MOCK=false
TRUST_PROXY=1

# Payments (in production, sandbox must be false if online payments are enabled)
ONLINE_PAYMENTS_ENABLED=false
ONLINE_PAYMENTS_SANDBOX=false
ONLINE_PAYMENTS_PROVIDER=generic
# ONLINE_PAYMENTS_PUBLIC_KEY=
# ONLINE_PAYMENTS_SECRET=

# Identity verification (if enabled, mock provider is forbidden in production)
IDENTITY_ENABLED=false
IDENTITY_PROVIDER=dia

# Backups
BACKUP_DIR=/backups
BACKUP_STATUS_PATH=/backups/last-backup.json
BACKUP_MAX_AGE_HOURS=192
REQUIRE_FINANCE_2FA=true

# --- Phase 2 (docs/UPGRADE-phase2.md) — усе опційне ---
# METRICS_TOKEN=REPLACE_WITH_RANDOM_TOKEN   # Bearer для GET /api/metrics (Prometheus); без нього в production → 404
# LOG_FORMAT=json                           # JSON-логи API/worker (Loki/ELK); за замовчуванням text
# LOG_LEVEL=log                             # error|warn|log|debug|verbose
# AUTH_CACHE_TTL_MS=0                       # кеш автентифікації (мс); 0 = вимкнено
# TENANT_AUTO_SCOPE=true                    # false = аварійно вимкнути автоматичну tenant-ізоляцію Prisma
# JOURNAL_SOT_STREAK_DAYS=30                # днів поспіль readyForSot перед перемиканням журналу як SoT
# BACKUP_ENCRYPTION_PASSPHRASE_FILE=/root/.dah-backup-pass   # шифрування infra/scripts/backup.sh (openssl)
# MINIO_IMAGE=minio/minio:RELEASE.<дата>    # закріпити версію MinIO
# MINIO_MC_IMAGE=minio/mc:RELEASE.<дата>
# DAH_VERSION=                              # перевизначити версію в /health, Swagger, метриках
