# Database
POSTGRES_USER=dah
POSTGRES_PASSWORD=dah_secret_change_me
POSTGRES_DB=dah
DATABASE_URL=postgresql://dah:dah_secret_change_me@postgres:5432/dah

# Redis
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible)
# Docker: http://minio:9000 | Local dev: http://localhost:9000
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=dah_minio
S3_SECRET_KEY=dah_minio_secret_change_me
S3_BUCKET=dah-files
S3_REGION=us-east-1

# Auth
JWT_SECRET=change_me_to_random_64_char_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Secure cookies (HttpOnly refresh). Auto-on when NODE_ENV=production; set true behind HTTPS.
# COOKIE_SECURE=true
# Backup health marker written by infra/scripts/backup.sh|ps1
# BACKUP_STATUS_PATH=./backups/last-backup.json
# BACKUP_MAX_AGE_HOURS=48
# In-app backup catalog dir (weekly/ + manual/); Docker: /backups
# BACKUP_DIR=./backups
# Optional max size for POST /api/backups/upload (MB). Unset / 0 / empty = unlimited.
# BACKUP_UPLOAD_MAX_MB=500

# Bootstrap (created on first API start if no users exist)
SUPER_ADMIN_EMAIL=admin@dah.local
SUPER_ADMIN_PASSWORD=change_me_super_admin_password

# Feature flags
REGISTRATION_ENABLED=true
SWAGGER_ENABLED=true
# Online payments (LiqPay / WayForPay / generic)
# ONLINE_PAYMENTS_ENABLED=true
# ONLINE_PAYMENTS_SECRET=change_me_hmac_secret
# ONLINE_PAYMENTS_PROVIDER=generic
# ONLINE_PAYMENTS_SANDBOX=true
# Production: SANDBOX=false + real provider keys; sandbox-complete then disabled
# ONLINE_PAYMENTS_SANDBOX=false
# ONLINE_PAYMENTS_PUBLIC_KEY=
# APP_URL=https://osbb.example.com
# Optional public API base for webhooks (defaults to APP_URL/api)
# API_PUBLIC_URL=https://osbb.example.com/api
# LiqPay: ONLINE_PAYMENTS_PROVIDER=liqpay + PUBLIC_KEY=public + SECRET=private
# WayForPay: ONLINE_PAYMENTS_PROVIDER=wayforpay + PUBLIC_KEY=merchantAccount
# Webhook: POST /api/payments/online/webhook (generic | LiqPay data+signature | WayForPay)

# SMS (OTP + login)
# SMS_ENABLED=true
# SMS_PROVIDER=log
# SMS_PROVIDER=turbosms
# SMS_PROVIDER=alphasms
# SMS_API_KEY=
# SMS_API_URL=
# SMS_SENDER=DAH
# SMS_OTP_TTL_SEC=300

# Multi-tenant (default on; set false only for emergency single-tenant debug)
# MULTI_TENANT_ENABLED=true

# Diia / BankID (identity login)
# IDENTITY_ENABLED=true
# IDENTITY_PROVIDER=mock
# IDENTITY_PROVIDER=diia
# IDENTITY_PROVIDER=bankid
# IDENTITY_CLIENT_ID=
# IDENTITY_CLIENT_SECRET=
# IDENTITY_AUTHORIZE_URL=
# IDENTITY_TOKEN_URL=
# IDENTITY_REDIRECT_URI=https://your-domain/login?identity=callback

# ─── КЕП / Дія.Підпис (збори, протоколи) ─────────────────────────────────────
# KEP_ENABLED=true
# KEP_PROVIDER=mock
# mock | diia | cloud_kep | cades
# KEP_ALLOW_MOCK=true
# KEP_MOCK_INSTANT=false
# KEP_SESSION_TTL_MIN=30
# Webhook secret (required in production)
# KEP_WEBHOOK_SECRET=change_me_kep_webhook_secret
#
# --- Дія.Підпис (acquirer API) — реєстрація: https://integration.diia.gov.ua/signature.html
# KEP_PROVIDER=diia
# KEP_DIIA_OFFER_URL=https://api2s.diia.gov.ua/api/v1/acquirers/offer-request
# KEP_DIIA_ACQUIRER_TOKEN=
# KEP_DIIA_API_KEY=
# KEP_DIIA_BRANCH_ID=
# KEP_DIIA_SIGN_ALGO=DSTU
# Without token: deeplink falls back to mock authorize page for local demos
#
# --- Хмарний КЕП (generic OAuth-style provider)
# KEP_PROVIDER=cloud_kep
# KEP_CLOUD_AUTHORIZE_URL=https://qes-provider.example/oauth/authorize
# KEP_CLOUD_TOKEN_URL=https://qes-provider.example/oauth/token
# KEP_CLOUD_CLIENT_ID=
# KEP_CLOUD_CLIENT_SECRET=
# KEP_CLOUD_SCOPE=sign
#
# --- CAdES (desktop EUSign / token): client signs digest, POST complete-auth with signatureCms
# KEP_PROVIDER=cades
#
# Public API base for mock page + webhooks (optional)
# API_PUBLIC_URL=https://osbb.example.com/api


# App
BUILDING_NAME=ОСББ вул. Прикладна 1
DEFAULT_LOCALE=uk
API_PORT=3001
WEB_PORT=3000
# Browser uses same-origin /api (Next.js rewrite → API). Direct URL for SSR/build only.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Web Push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@osbb.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Email (optional — without SMTP letters are logged to API + EmailLog)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=DAH OSMD <noreply@osbb.example.com>
# Public link in email bodies
# APP_URL=https://osbb.example.com

# Production (HTTPS)
DOMAIN=osbb.example.com
CORS_ORIGIN=https://osbb.example.com
# NEXT_PUBLIC_API_URL=https://osbb.example.com/api
SSL_CERT_DIR=./infra/certs